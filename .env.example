DATABASE_URL=postgres://blokm:blokm@localhost:5432/blokm?sslmode=disable
API_ADDR=:8080
AUTO_SEED=1
# Local demo token. `make api` / `make demo` also default to blokm-demo.
# Required for /admin/* (header X-Admin-Token). Leave unset in the process to lock admin.
ADMIN_TOKEN=blokm-demo

# Frontend (copy into web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional. When unset, the map uses Leaflet + OpenStreetMap tiles (no key required).
# NEXT_PUBLIC_MAPBOX_TOKEN=
