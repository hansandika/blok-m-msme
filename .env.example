DATABASE_URL=postgres://blokm:blokm@localhost:5432/blokm?sslmode=disable
API_ADDR=:8080
AUTO_SEED=1
# Local demo token. `make api` / `make demo` also default to blokm-demo.
# Required for /admin/* (header X-Admin-Token). Leave unset in the process to lock admin.
ADMIN_TOKEN=blokm-demo

# Optional hosted Postgres (Supabase project blok-m-msme, ref sfeebnwtaxnztglvutvd, ap-southeast-1).
# https://sfeebnwtaxnztglvutvd.supabase.co
# Schema (places + suggestions, incl. applied_at / applied_place_id) + 56 seed rows already loaded; RLS on.
# Session pooler port 5432 — pgx prepared statements break on transaction-mode :6543.
# Direct db.*.supabase.co is IPv6-only. Copy the password from the dashboard; never commit it.
# DATABASE_URL=postgresql://postgres.sfeebnwtaxnztglvutvd:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# AUTO_SEED=0

# Frontend (copy into web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional. When unset, the map uses Leaflet + OpenStreetMap tiles (no key required).
# NEXT_PUBLIC_MAPBOX_TOKEN=
